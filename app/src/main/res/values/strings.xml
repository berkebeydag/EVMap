    <!-- Diagnostics -->
    <string name="dtc_clear_title">Clear stored trouble codes?</string>
    <string name="dtc_clear_body">This erases stored DTCs and freeze-frame data from the vehicle. It cannot be undone, and it also resets readiness monitors. Only do this if you know why the codes are there.</string>
