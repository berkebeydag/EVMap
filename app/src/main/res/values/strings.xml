    <!-- Permissions -->
    <string name="perm_title">Bluetooth permission needed</string>
    <string name="perm_body">IoniqScope needs Bluetooth access to find and talk to your OBD-II adapter. Nothing leaves your phone — the app has no internet permission at all.</string>
    <string name="perm_location_note">On Android 11 and older, Android requires location permission to scan for Bluetooth LE devices. IoniqScope never uses your location.</string>
    <string name="perm_grant">Grant permission</string>
    <string name="perm_denied_settings">Permission was denied. Enable it in system settings to scan for adapters.</string>

