<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Trip/run history and settings are local-only; excluding them keeps the
         app's data strictly on this device. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
