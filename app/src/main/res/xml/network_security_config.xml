<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Everything real goes over HTTPS. The only cleartext exception is loopback:
      10.0.2.2 is how an emulator reaches the development machine, which is the
      only way to exercise the update download path without publishing a build
      first. These addresses can never be a real server, so allowing them costs
      nothing in production.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
