<?xml version="1.0" encoding="utf-8"?>
<!--
  A map pin holding a charge bolt, with a road running out of its base.

  Drawn inside the 72dp adaptive-icon safe zone (18..90 of the 108 viewport), so no
  launcher mask can clip the point off the bottom or the shoulders off the sides.

  The road is a group clipped to the pin's own outline, which keeps it inside the
  shape without a second copy of the silhouette to keep in sync.

  This is also the monochrome layer, where the system discards the colours and tints
  the whole thing — so the shapes have to carry the icon on their own. They do: the
  bolt is a hole in a filled disc, and the road reads as a band across the base.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pin body. Teal at the shoulders falling to a deep sea green at the point,
         which is what gives the flat shape its roundness. -->
    <path android:pathData="M54,86 C54,86 76,63 76,47 A22,22 0 1,0 32,47 C32,63 54,86 54,86 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="25"
                android:endX="78"
                android:endY="86"
                android:type="linear">
                <item android:offset="0" android:color="#FF17B3C4" />
                <item android:offset="0.55" android:color="#FF0E8FA0" />
                <item android:offset="1" android:color="#FF0B6B78" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The road, clipped to the pin so it cannot spill past the silhouette. -->
    <group>
        <clip-path android:pathData="M54,86 C54,86 76,63 76,47 A22,22 0 1,0 32,47 C32,63 54,86 54,86 Z" />

        <!-- Verge, on the far side only, the way it sits in the mark. -->
        <path
            android:fillColor="#FF6DBE4B"
            android:pathData="M24,70 C38,58 58,54 84,56 L84,61 C62,59 44,63 29,74 Z" />

        <!-- Carriageway, widening as it comes towards the point. -->
        <path
            android:fillColor="#FF34495E"
            android:pathData="M20,86 C34,64 56,58 86,60 L86,71 C62,69 44,75 33,89 Z" />

        <!-- Centre line. -->
        <path
            android:fillColor="#FFF2F7F9"
            android:pathData="M27,82 C40,66 58,62 85,64 L85,67 C62,65 45,70 32,84 Z" />
    </group>

    <!-- The disc the bolt is cut out of. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,47 m-15.5,0 a15.5,15.5 0 1,0 31,0 a15.5,15.5 0 1,0 -31,0" />

    <!-- Charge bolt. -->
    <path
        android:fillColor="#FF2C3E50"
        android:pathData="M57,35 L45.5,50.5 L52.5,50.5 L50.5,60 L62.5,44.5 L55.5,44.5 Z" />
</vector>
